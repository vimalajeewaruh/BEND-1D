meta = struct("ID","TF148","Name","Normalized AR(1) Square","Category",7,"RecommendedN",1024, ...
    "Parameters",struct("seed",seed,"rho",rho,"frequency",frequency), ...
    "Morphology","Zero-mean unit-variance square waveform with correlated noise");
end

