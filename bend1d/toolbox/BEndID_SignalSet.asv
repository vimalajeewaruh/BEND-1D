function [x,f,meta] = TF039_TriangularPulse(N,center,width)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(center), center = 0.5; end
if nargin < 3 || isempty(width), width = 0.3; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).';
f = max(1 - abs(x-center)./(width/2),0);
meta = struct("ID","TF039","Name","Triangular Pulse","Category",2,"RecommendedN",1024, ...
    "Parameters",struct("center",center,"width",width),"Morphology","Localized piecewise-linear pulse");
end

function [x,f,meta] = TF040_ParabolicPulse(N,center,width)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(center), center = 0.5; end
if nargin < 3 || isempty(width), width = 0.3; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = max(1 - ((x-center)./(width/2)).^2,0);
meta = struct("ID","TF040","Name","Parabolic Pulse","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("center",center,"width",width),"Morphology","Localized smooth compact pulse");
end

function [x,f,meta] = TF041_Cauchy(N,mu,gamma)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(mu), mu = 0.5; end
if nargin < 3 || isempty(gamma), gamma = 0.06; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = 1./(pi*gamma*(1 + ((x-mu)./gamma).^2));
meta = struct("ID","TF041","Name","Cauchy","Category",5,"RecommendedN",1024, ...
    "Parameters",struct("mu",mu,"gamma",gamma),"Morphology","Localized peak with heavy algebraic tails");
end

function [x,f,meta] = TF042_BetaDistribution(N,a,b)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(a), a = 2; end
if nargin < 3 || isempty(b), b = 5; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).';
f = x.^(a-1).*(1-x).^(b-1)/beta(a,b);
meta = struct("ID","TF042","Name","Beta Distribution","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("a",a,"b",b),"Morphology","Smooth bounded asymmetric distribution");
end

function [x,f,meta] = TF043_GammaDistribution(N,shape,scale)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(shape), shape = 2; end
if nargin < 3 || isempty(scale), scale = 0.2; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = x.^(shape-1).*exp(-x./scale)./(gamma(shape)*scale^shape);
meta = struct("ID","TF043","Name","Gamma Distribution","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("shape",shape,"scale",scale),"Morphology","Smooth positive skewed distribution");
end

function [x,f,meta] = TF044_LogNormal(N,mu,sigma)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(mu), mu = -1; end
if nargin < 3 || isempty(sigma), sigma = 0.5; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = exp(-0.5*((log(max(x,eps))-mu)./sigma).^2)./(max(x,eps)*sigma*sqrt(2*pi));
meta = struct("ID","TF044","Name","Log-Normal","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("mu",mu,"sigma",sigma),"Morphology","Smooth positively skewed distribution");
end

function [x,f,meta] = TF045_Weibull(N,shape,scale)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(shape), shape = 2; end
if nargin < 3 || isempty(scale), scale = 0.35; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = (shape/scale)*(x/scale).^(shape-1).*exp(-(x/scale).^shape);
meta = struct("ID","TF045","Name","Weibull","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("shape",shape,"scale",scale),"Morphology","Smooth skewed distribution with tunable tail");
end

function [x,f,meta] = TF046_Rayleigh(N,scale)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(scale), scale = 0.3; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = (x./scale.^2).*exp(-x.^2./(2*scale.^2));
meta = struct("ID","TF046","Name","Rayleigh","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("scale",scale),"Morphology","Smooth unimodal distribution with positive skew");
end

function [x,f,meta] = TF047_Rice(N,nu,sigma)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(nu), nu = 0.4; end
if nargin < 3 || isempty(sigma), sigma = 0.15; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).';
f = (x./sigma.^2).*exp(-(x.^2 + nu.^2)./(2*sigma.^2)).*besseli(0,x.*nu./sigma.^2);
meta = struct("ID","TF047","Name","Rice","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("nu",nu,"sigma",sigma),"Morphology","Smooth noncentral radial distribution");
end

function [x,f,meta] = TF048_ChiSquare(N,degree)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(degree), degree = 4; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).';
f = x.^(degree/2-1).*exp(-x/2)./(2^(degree/2)*gamma(degree/2));
meta = struct("ID","TF048","Name","Chi-Square","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("degree",degree),"Morphology","Smooth positively skewed distribution");
end

function [x,f,meta] = TF049_StudentT(N,nu)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(nu), nu = 5; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; t = (x-0.5)/0.15;
f = gamma((nu+1)/2)/(sqrt(nu*pi)*gamma(nu/2)*0.15) .* (1+t.^2/nu).^(-(nu+1)/2);
meta = struct("ID","TF049","Name","Student-t","Category",5,"RecommendedN",1024, ...
    "Parameters",struct("nu",nu),"Morphology","Localized heavy-tailed symmetric distribution");
end

function [x,f,meta] = TF050_Laplace(N,mu,scale)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(mu), mu = 0.5; end
if nargin < 3 || isempty(scale), scale = 0.08; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
