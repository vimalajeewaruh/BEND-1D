function [x,f,meta] = TF035_MexicanHat(N,mu,sigma)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(mu), mu = 0.5; end
if nargin < 3 || isempty(sigma), sigma = 0.08; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; u = (x-mu)./sigma;
f = (1-u.^2).*exp(-0.5*u.^2);
meta = struct("ID","TF035","Name","Mexican Hat","Category",3,"RecommendedN",1024, ...
    "Parameters",struct("mu",mu,"sigma",sigma),"Morphology","Localized oscillatory wavelet with central peak");
end

