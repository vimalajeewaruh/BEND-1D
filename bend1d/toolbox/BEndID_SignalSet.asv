rng(seed); x = linspace(0,1,N).';
f = exp(-0.5*((x-mu)./sigma).^2).*cos(2*pi*frequency*(x-mu)) + filter(1,[1 -rho1 -rho2],randn(size(x)));
meta = struct("ID","TF227","Name","AR(2) Gabor","Category",7,"RecommendedN",1024, ...
    "Parameters",struct("seed",seed,"rho1",rho1,"rho2",rho2,"frequency",frequency,"mu",mu,"sigma",sigma), ...
    "Morphology","Localized oscillatory Gaussian waveform with second-order correlated stochastic fluctuations");
end

function [x,f,meta] = TF228_AR2GaborNormalized(N,seed,rho1,rho2,frequency,mu,sigma)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(seed), seed = 1; end
if nargin < 3 || isempty(rho1), rho1 = 1.4; end
if nargin < 4 || isempty(rho2), rho2 = -0.5; end
if nargin < 5 || isempty(frequency), frequency = 10; end
if nargin < 6 || isempty(mu), mu = 0.5; end
if nargin < 7 || isempty(sigma), sigma = 0.1; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
rng(seed); x = linspace(0,1,N).';
f = exp(-0.5*((x-mu)./sigma).^2).*cos(2*pi*frequency*(x-mu)) + filter(1,[1 -rho1 -rho2],randn(size(x)));
f = (f-mean(f))./std(f);
meta = struct("ID","TF228","Name","Normalized AR(2) Gabor","Category",7,"RecommendedN",1024, ...
    "Parameters",struct("seed",seed,"rho1",rho1,"rho2",rho2,"frequency",frequency,"mu",mu,"sigma",sigma), ...
    "Morphology","Zero-mean unit-variance localized Gabor waveform with second-order correlated noise");
end









































































































































































































































































