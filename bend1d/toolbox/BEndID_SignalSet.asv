f = (1-kappa^2)./(1-2*kappa*cos(2*pi*(x-mu))+kappa^2);
meta = struct("ID","TF070","Name","Poisson Kernel","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("mu",mu,"kappa",kappa),"Morphology","Periodic localized kernel with tunable concentration");
end

