f = base + filter(1,[1 -rho],randn(size(x)));
meta = struct("ID","TF181","Name","AR(1) Student-t","Category",7,"RecommendedN",1024, ...
    "Parameters",struct("seed",seed,"rho",rho,"nu",nu), ...
    "Morphology","Localized heavy-tailed distribution with correlated stochastic fluctuations");
end

