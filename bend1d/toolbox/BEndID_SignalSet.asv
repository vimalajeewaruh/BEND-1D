if nargin < 2 || isempty(x0), x0 = 0.2; end
if nargin < 3 || isempty(x1), x1 = 0.8; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).';
f = min(max((x-x0)./(x1-x0),0),1);
meta = struct("ID","TF017","Name","Ramp","Category",2, ...
    "RecommendedN",1024,"Parameters",struct("x0",x0,"x1",x1), ...
    "Morphology","Piecewise-linear transition with bounded plateaus");
end

function [x,f,meta] = TF018_DoubleGaussian(N,mu1,mu2,sigma)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(mu1), mu1 = 0.35; end
if nargin < 3 || isempty(mu2), mu2 = 0.65; end
if nargin < 4 || isempty(sigma), sigma = 0.06; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).';
f = exp(-0.5*((x-mu1)./sigma).^2) + exp(-0.5*((x-mu2)./sigma).^2);
meta = struct("ID","TF018","Name","Double Gaussian","Category",1, ...
    "RecommendedN",1024,"Parameters",struct("mu1",mu1,"mu2",mu2,"sigma",sigma), ...
    "Morphology","Two localized smooth symmetric peaks");
end

