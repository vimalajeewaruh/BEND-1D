function [x,f,meta] = TF012_Sine(N,frequency,phase)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(frequency), frequency = 3; end
if nargin < 3 || isempty(phase), phase = 0; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).';
f = 0.5 + 0.5*sin(2*pi*frequency*x + phase);
meta = struct("ID","TF012","Name","Sine","Category",3, ...
    "RecommendedN",1024,"Parameters",struct("frequency",frequency,"phase",phase), ...
    "Morphology","Smooth periodic oscillation");
end

function [x,f,meta] = TF013_Sawtooth(N,frequency,phase)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(frequency), frequency = 3; end
if nargin < 3 || isempty(phase), phase = 0; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).';
f = mod(frequency*x + phase/(2*pi),1);
meta = struct("ID","TF013","Name","Sawtooth","Category",2, ...
    "RecommendedN",1024,"Parameters",struct("frequency",frequency,"phase",phase), ...
    "Morphology","Piecewise-linear periodic ramp with abrupt resets");
end
