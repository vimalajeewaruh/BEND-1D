function [x,f,meta] = TF055_Chirp(N,frequency0,frequency1,phase)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(frequency0), frequency0 = 2; end
if nargin < 3 || isempty(frequency1), frequency1 = 12; end
if nargin < 4 || isempty(phase), phase = 0; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).';
f = 0.5 + 0.5*sin(2*pi*(frequency0*x + 0.5*(frequency1-frequency0)*x.^2) + phase);
meta = struct("ID","TF055","Name","Chirp","Category",3,"RecommendedN",1024, ...
    "Parameters",struct("frequency0",frequency0,"frequency1",frequency1,"phase",phase), ...
    "Morphology","Smooth oscillation with linearly varying frequency");
end

