    "Parameters",struct("lambda",lambda),"Morphology","Smooth monotonic exponential growth");
end

function [x,f,meta] = TF037_SigmoidBump(N,mu,width)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(mu), mu = 0.5; end
if nargin < 3 || isempty(width), width = 0.08; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = 1./(1 + exp(-((x-mu+width/2)./width))) - 1./(1 + exp(-((x-mu-width/2)./width)));
meta = struct("ID","TF037","Name","Sigmoid Bump","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("mu",mu,"width",width),"Morphology","Smooth localized plateau with sigmoid edges");
end

