function [x,f,meta] = TF026_WhiteNoise(N,seed)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(seed), seed = 1; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
rng(seed);
x = linspace(0,1,N).';
f = randn(size(x));
meta = struct("ID","TF026","Name","White Noise","Category",7, ...
    "RecommendedN",1024,"Parameters",struct("seed",seed), ...
    "Morphology","Uncorrelated stochastic fluctuations");
end

function [x,f,meta] = TF027_PinkNoise(N,seed)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(seed), seed = 1; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
rng(seed);
x = linspace(0,1,N).';
noise = randn(size(x));
spectrum = fft(noise);
frequencies = (0:N-1).';
spectrum(2:end) = spectrum(2:end)./sqrt(frequencies(2:end));
f = real(ifft(spectrum));
meta = struct("ID","TF027","Name","Pink Noise","Category",7, ...
    "RecommendedN",1024,"Parameters",struct("seed",seed), ...
    "Morphology","Correlated stochastic fluctuations with 1/f spectral scaling");
end

function [x,f,meta] = TF028_BrownianNoise(N,seed)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(seed), seed = 1; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
rng(seed);
x = linspace(0,1,N).';
f = cumsum(randn(size(x))); f = (f-mean(f))./std(f);
meta = struct("ID","TF028","Name","Brownian Noise","Category",7, ...
    "RecommendedN",1024,"Parameters",struct("seed",seed), ...
    "Morphology","Integrated stochastic fluctuations with strong low-frequency content");
end

