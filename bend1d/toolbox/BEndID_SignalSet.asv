function [x,f,meta] = TF054_MorletWavelet(N,frequency,mu,sigma)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(frequency), frequency = 8; end
if nargin < 3 || isempty(mu), mu = 0.5; end
if nargin < 4 || isempty(sigma), sigma = 0.1; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = exp(-0.5*((x-mu)./sigma).^2).*cos(2*pi*frequency*(x-mu));
meta = struct("ID","TF054","Name","Morlet Wavelet","Category",3,"RecommendedN",1024, ...
    "Parameters",struct("frequency",frequency,"mu",mu,"sigma",sigma), ...
    "Morphology","Localized oscillatory wavelet with Gaussian envelope");
