function [x,f,meta] = TF061_BartlettWindow(N)
if nargin < 1 || isempty(N), N = 1024; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = 1 - abs(2*x - 1);
meta = struct("ID","TF061","Name","Bartlett Window","Category",1,"RecommendedN",1024, ...
    "Parameters",struct,"Morphology","Piecewise-linear triangular window");
end

function [x,f,meta] = TF062_BartlettHannWindow(N)
if nargin < 1 || isempty(N), N = 1024; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).';
f = 0.62 - 0.48*abs(x-0.5) + 0.38*cos(2*pi*x);
meta = struct("ID","TF062","Name","Bartlett-Hann Window","Category",1,"RecommendedN",1024, ...
    "Parameters",struct,"Morphology","Piecewise-smooth tapered window");
end

function [x,f,meta] = TF063_KaiserWindow(N,beta)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(beta), beta = 8.6; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = besseli(0,beta*sqrt(max(1-(2*x-1).^2,0)))./besseli(0,beta);
meta = struct("ID","TF063","Name","Kaiser Window","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("beta",beta),"Morphology","Smooth adjustable-taper window");
end

function [x,f,meta] = TF064_GaussianWindow(N,sigma)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(sigma), sigma = 0.18; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = exp(-0.5*((x-0.5)./sigma).^2);
meta = struct("ID","TF064","Name","Gaussian Window","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("sigma",sigma),"Morphology","Smooth localized window with Gaussian taper");
end

function [x,f,meta] = TF065_TukeyWindow(N,alpha)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(alpha), alpha = 0.5; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = ones(size(x));
edge = alpha/2;
left = x < edge; right = x > 1-edge;
f(left) = 0.5*(1 + cos(2*pi*(x(left)/alpha - 0.5)));
f(right) = 0.5*(1 + cos(2*pi*((x(right)-1)/alpha + 0.5)));
meta = struct("ID","TF065","Name","Tukey Window","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("alpha",alpha),"Morphology","Cosine-tapered window with adjustable flat center");
end


function [x,f,meta] = TF066_ParzenWindow(N)
if nargin < 1 || isempty(N), N = 1024; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; u = abs(2*x-1);
f = (u <= 0.5).*(1 - 6*u.^2 + 6*u.^3) + (u > 0.5 & u <= 1).*2.*(1-u).^3;
meta = struct("ID","TF066","Name","Parzen Window","Category",1,"RecommendedN",1024, ...
    "Parameters",struct,"Morphology","Smooth compact window with cubic taper");
end

function [x,f,meta] = TF067_BohmanWindow(N)
if nargin < 1 || isempty(N), N = 1024; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; u = abs(2*x-1);
f = (1-u).*cos(pi*u) + sin(pi*u)/pi;
meta = struct("ID","TF067","Name","Bohman Window","Category",1,"RecommendedN",1024, ...
    "Parameters",struct,"Morphology","Smooth compact window with cosine-polynomial taper");
end

function [x,f,meta] = TF068_CosineWindow(N)
if nargin < 1 || isempty(N), N = 1024; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = sin(pi*x);
meta = struct("ID","TF068","Name","Cosine Window","Category",1,"RecommendedN",1024, ...
    "Parameters",struct,"Morphology","Smooth symmetric cosine-tapered window");
end

