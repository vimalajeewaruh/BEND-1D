meta = struct("ID","TF050","Name","Laplace","Category",5,"RecommendedN",1024, ...
    "Parameters",struct("mu",mu,"scale",scale),"Morphology","Localized symmetric peak with exponential tails");
end

function [x,f,meta] = TF051_HyperbolicSecant(N,mu,scale)
if nargin < 1 || isempty(N), N = 1024; end
if nargin < 2 || isempty(mu), mu = 0.5; end
if nargin < 3 || isempty(scale), scale = 0.08; end
validateattributes(N,{'numeric'},{'scalar','integer','>=',2});
x = linspace(0,1,N).'; f = sech((x-mu)./scale).^2./(pi*scale);
meta = struct("ID","TF051","Name","Hyperbolic Secant","Category",1,"RecommendedN",1024, ...
    "Parameters",struct("mu",mu,"scale",scale),"Morphology","Localized smooth symmetric peak");
end

